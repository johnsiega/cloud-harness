{
  "name": "cloud-native-ai-harness",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test scripts/smoke-test.test.ts scripts/monitoring.test.ts scripts/runner/server.test.ts scripts/runner/detect-tests.test.ts tests/unit/*.test.ts tests/simulation/*.test.ts tests/integration/*.test.ts",
    "test:unit": "node --test tests/unit/*.test.ts",
    "smoke": "node scripts/smoke-test.ts",
    "start": "node api/main.ts",
    "test:integration": "node --test tests/integration/end-to-end.test.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-lambda-microvms": "^3.1175.0",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
