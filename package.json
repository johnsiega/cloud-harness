{
  "name": "cloud-native-ai-harness",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test scripts/smoke-test.test.ts scripts/monitoring.test.ts scripts/runner/server.test.ts tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:unit": "node --test tests/unit/*.test.ts",
    "smoke": "node scripts/smoke-test.ts",
    "start": "node api/main.ts",
    "test:integration": "node --test tests/integration/end-to-end.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-lambda-microvms": "^3.1175.0",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21"
  }
}
